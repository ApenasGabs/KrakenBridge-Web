# ========================================================
# Configuração do Antigravity Studio para ZimaOS / Docker
# ========================================================

# Diretório raiz com seus projetos de código no host do ZimaOS
# Padrão no ZimaOS: /DATA/Projetos ou /DATA/AppData/workspace
WORKSPACE_PATH=/DATA/Projetos

# Diretório para persistir extensões e configurações do VS Code Web
CODE_SERVER_CONFIG=/DATA/AppData/code-server-config

# Diretório para persistir credenciais e histórico do Antigravity CLI
ANTIGRAVITY_CLI_CONFIG=/DATA/AppData/antigravity/config

# Portas de Acesso Web
WEB_PORT=8088
IDE_PORT=8089

# Permissões do Usuário do Host (Execute 'id' no servidor para ver o seu UID/GID)
PUID=1000
PGID=1000
TZ=America/Sao_Paulo

# Autenticação (Opcional - deixe vazio para acesso sem senha na rede local)
IDE_PASSWORD=
IDE_SUDO_PASSWORD=password

# Chave de API Google Gemini (Opcional se autenticado via agy auth)
GEMINI_API_KEY=
