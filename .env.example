# ========================================================
# KrakenBridge Web: Configurações de Ambiente (Out-of-the-Box)
# ========================================================

# Diretório raiz com seus projetos de código no host
# Padrão no ZimaOS: /DATA/Projetos
WORKSPACE_PATH=/DATA/Projetos

# Diretório para persistir extensões e configurações do VS Code Web
CODE_SERVER_CONFIG=/DATA/AppData/code-server-config

# Diretório para persistir credenciais e histórico do KrakenBridge
KRAKEN_CONFIG_PATH=/DATA/AppData/krakenbridge/config

# Portas de Acesso Web
WEB_PORT=8088
IDE_PORT=8089

# Permissões do Usuário do Host
PUID=1000
PGID=1000
TZ=America/Sao_Paulo

# Autenticação VS Code (Opcional - deixe vazio para acesso sem senha na rede local)
IDE_PASSWORD=
IDE_SUDO_PASSWORD=password

# PIN de Segurança da Interface Web (Opcional)
KRAKEN_PIN=

# ========================================================
# Chaves de API para os Agentes de IA
# ========================================================
# Google Gemini (para Antigravity)
GEMINI_API_KEY=

# Anthropic Claude (para Claude Code)
ANTHROPIC_API_KEY=

# OpenAI (para Codex / Aider)
OPENAI_API_KEY=

# ========================================================
# Telemetria Out-of-the-Box & Contenção de Pré-Degradação (Cgroups)
# ========================================================
# Quando true, o Kraken auto-configura cAdvisor, VictoriaMetrics, Grafana e Uptime Kuma no boot
AUTO_PROVISION_TELEMETRY=true
TELEMETRY_DIR=/DATA/AppData/telemetria

# Portas da Stack de Telemetria
GRAFANA_PORT=3003
UPTIME_KUMA_PORT=3002
VICTORIAMETRICS_PORT=8428
CADVISOR_PORT=8082

# Limites de Recursos Cgroups (Contenção física anti-OOMKill)
DEFAULT_CONTAINER_MEM_LIMIT=512M
DEFAULT_CONTAINER_CPU_LIMIT=1.0
KRAKEN_MEMORY_LIMIT=1536M
KRAKEN_CPU_LIMIT=1.5
IDE_MEMORY_LIMIT=1024M
IDE_CPU_LIMIT=1.5
