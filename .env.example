# ========================================================
# KrakenBridge Web: Configurações de Ambiente
# ========================================================

# Diretório raiz com seus projetos de código no host
# Padrão no ZimaOS: /DATA/Projetos
WORKSPACE_PATH=/DATA/Projetos

# Diretório para persistir extensões e configurações do VS Code Web
CODE_SERVER_CONFIG=/DATA/AppData/code-server-config

# Diretório para persistir credenciais e histórico do KrakenBridge
KRAKEN_CONFIG_PATH=/DATA/AppData/krakenbridge/config

# Portas de Acesso Web
WEB_PORT=8088
IDE_PORT=8089

# Permissões do Usuário do Host
PUID=1000
PGID=1000
TZ=America/Sao_Paulo

# Autenticação VS Code (Opcional - deixe vazio para acesso sem senha na rede local)
IDE_PASSWORD=
IDE_SUDO_PASSWORD=password

# ========================================================
# Chaves de API para os Agentes de IA
# ========================================================
# Google Gemini (para Antigravity)
GEMINI_API_KEY=

# Anthropic Claude (para Claude Code)
ANTHROPIC_API_KEY=

# OpenAI (para Codex / Aider)
OPENAI_API_KEY=
