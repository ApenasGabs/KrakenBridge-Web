{
  "name": "krakenbridge-web",
  "version": "1.0.0",
  "description": "KrakenBridge Web: Autonomous Multi-Agent AI Bridge & Integrated VS Code for ZimaOS and Docker",
  "type": "module",
  "main": "dist-server/server.js",
  "scripts": {
    "start": "node dist-server/server.js",
    "build:server": "tsc",
    "build:frontend": "npm run --prefix frontend build",
    "build": "npm run build:frontend && npm run build:server",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "krakenbridge",
    "ai-agents",
    "antigravity",
    "claude-code",
    "codex",
    "aider",
    "zimaos",
    "casaos",
    "docker",
    "code-server",
    "homelab"
  ],
  "author": "KrakenBridge Community",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
