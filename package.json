{
  "name": "krakenbridge-web",
  "version": "1.19.0",
  "description": "KrakenBridge Web: Autonomous Multi-Agent AI Bridge & Integrated VS Code for ZimaOS and Docker",
  "type": "module",
  "main": "dist-server/server.js",
  "scripts": {
    "start": "node dist-server/server.js",
    "build:server": "tsc && mkdir -p dist-server/templates && cp -r src/templates/* dist-server/templates/ 2>/dev/null || true",
    "build:frontend": "NODE_OPTIONS=--max-old-space-size=1536 npm run --prefix frontend build",
    "build": "npm run build:frontend && npm run build:server",
    "test": "npm run --prefix frontend test -- --run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run --prefix frontend test:e2e",
    "test:responsive": "npm run --prefix frontend test:responsive",
    "test:e2e:ui": "npm run --prefix frontend test:e2e:ui",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "keywords": [
    "krakenbridge",
    "ai-agents",
    "antigravity",
    "claude-code",
    "codex",
    "aider",
    "zimaos",
    "casaos",
    "docker",
    "code-server",
    "homelab"
  ],
  "author": "KrakenBridge Community",
  "license": "MIT",
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "typescript": "^7.0.2",
    "vercel": "^64.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@types/qrcode": "^1.5.6",
    "@types/selfsigned": "^2.0.4",
    "@types/web-push": "^3.6.4",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "semantic-release": "^24.2.9"
  }
}
